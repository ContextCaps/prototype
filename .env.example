# Broker (services/broker)
BROKER_PORT=8787
BROKER_HOST=127.0.0.1
# mock | monad  (monad requires Person 1's @contextcaps/contract-sdk)
CHAIN_PROVIDER=mock
# Person 1 / Monad Testnet. Principal in POST /mandates must equal this signer's address.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PRIVATE_KEY=
CONTEXTCAPS_REGISTRY_ADDRESS=
# Optional separate broker wallet allowed to anchor receipts (defaults to deployer).
CONTEXTCAPS_RECEIPT_WRITER=
# Key for receipt result commitments. REQUIRED when CHAIN_PROVIDER=monad.
RECEIPT_HMAC_KEY=
# Enables POST /api/v1/demo/reset
DEMO_MODE=true
# Comma-separated allowed origins for the web app (default: any)
CORS_ORIGINS=http://localhost:5173

# LLM planner (optional). "openai" enables POST /agent/runs {"planner":"llm"}.
# Off by default because it spends API credits; the scripted planner always works.
LLM_PLANNER=off
# Credentials: OPENAI_API_KEY
OPENAI_API_KEY=
# Defaults: gpt-5.4-mini, effort low
OPENAI_MODEL=
LLM_EFFORT=
