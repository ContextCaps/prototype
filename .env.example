# Broker (services/broker)
BROKER_PORT=8787
BROKER_HOST=127.0.0.1
# Hosting: listen on all interfaces (BROKER_HOST=0.0.0.0); the port falls back to the platform PORT.
# Serve the built web app (npm run build:web) at / and /demo/ from this same service.
STATIC_DIR=
# mock | monad  (monad requires Person 1's @contextcaps/contract-sdk)
CHAIN_PROVIDER=mock
# server: the broker signer registers/revokes for the principal (demo scripts, tests).
# wallet: the principal signs root registration and revocation in their own wallet (MetaMask);
#         the broker key is only the operator (children, delegation links, receipts). Requires monad.
PRINCIPAL_SIGNING=server
# Person 1 / Monad Testnet. Server signing: principal in POST /mandates must equal this signer's address.
# Wallet signing: this is the broker operator key; the registry's receiptWriter must be its address.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PRIVATE_KEY=
CONTEXTCAPS_REGISTRY_ADDRESS=
# Optional separate broker wallet allowed to anchor receipts (defaults to deployer).
CONTEXTCAPS_RECEIPT_WRITER=
# Key for receipt result commitments. REQUIRED when CHAIN_PROVIDER=monad.
RECEIPT_HMAC_KEY=
# Enables POST /api/v1/demo/reset
DEMO_MODE=true
# Comma-separated allowed origins for the web app (default: any)
CORS_ORIGINS=http://localhost:5173

# LLM planner (optional). "openai" enables POST /agent/runs {"planner":"llm"}.
# Off by default because it spends API credits; the scripted planner always works.
LLM_PLANNER=off
# Credentials: OPENAI_API_KEY
OPENAI_API_KEY=
# Defaults: gpt-5.4-mini, model-default effort (gpt-5.4-mini rejects LLM_EFFORT with tools)
OPENAI_MODEL=
LLM_EFFORT=
