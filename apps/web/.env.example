# Broker base URL as seen by the browser. Leave unset in development to use
# the Vite proxy (/api -> BROKER_PROXY_TARGET). Set it for deployed builds,
# e.g. https://broker.example.com/api/v1 (the broker's CORS_ORIGINS must allow this app).
VITE_API_BASE=

# Dev-server proxy target for /api (default http://127.0.0.1:8787).
BROKER_PROXY_TARGET=

# Mandate principal. Mock trust layer: any id (default 0xA11CE).
# CHAIN_PROVIDER=monad: must be the broker signer's full wallet address.
VITE_PRINCIPAL=
